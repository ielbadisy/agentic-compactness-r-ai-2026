# Whitelist: only the experiment code is tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/slides/
/slides/*
!/slides/agentic-compactness-RAI2026-slides.pdf
!/experiment-biobench/
/experiment-biobench/*
!/experiment-biobench/R/
!/experiment-biobench/issues/
/experiment-biobench/issues/*
!/experiment-biobench/issues/reprex/
!/experiment/
/experiment/*
!/experiment/R/
/experiment/R/*
!/experiment/R/measure_compactness.R
!/experiment/results/
/experiment/results/*
!/experiment/results/figures/
/experiment/results/figures/*
!/experiment/results/figures/code_listing.tex
# Final results (no console logs)
!/experiment-biobench/results/
/experiment-biobench/results/*.log
/experiment-biobench/results/runs/*/log.txt
